# ==============================================================================
# SNAPPRICE MX - VARIABLES DE ENTORNO (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVIDOR BACKEND (EXPRESS & IA) - PRIVADAS / NUNCA EXPUESTAS AL NAVEGADOR
# ------------------------------------------------------------------------------
# Clave de API de Google Gemini para valuación multimodal
GEMINI_API_KEY="AIzaSy..."

# El servidor usa Application Default Credentials para verificar Firebase Auth
# y administrar cuotas. En Cloud Run, asigna permisos Firestore a su cuenta de servicio.
# En desarrollo local, configura GOOGLE_APPLICATION_CREDENTIALS fuera del repositorio
# o ejecuta `gcloud auth application-default login`.
# Debe coincidir con VITE_FIREBASE_PROJECT_ID / src/firebase-config.json.
FIREBASE_PROJECT_ID=""
FIRESTORE_DATABASE_ID=""

# Requerir Firebase App Check en POST /api/evaluate (activar tras registrar la app).
APP_CHECK_ENFORCED="false"

# OAuth de la cuenta operativa de SnapPrice para consultar publicaciones de Mercado Libre.
# Registra exactamente MELI_REDIRECT_URI en la aplicación de Mercado Libre.
MELI_CLIENT_ID=""
MELI_CLIENT_SECRET=""
MELI_REDIRECT_URI="https://tu-dominio.example/api/mercadolibre/oauth/callback"
# Clave administrativa aleatoria de al menos 32 caracteres; solo se usa en encabezados
# Authorization: Bearer para iniciar y revisar el estado de la conexión OAuth.
MELI_OAUTH_SETUP_KEY=""

# Prueba opcional de ofertas de Google Shopping a través de SerpApi.
# Por defecto no realiza consultas. Actívala solo tras revisar coste y condiciones:
SERPAPI_API_KEY=""
SERPAPI_ENABLED="false"

# Puerto del servidor (por defecto 3000)
PORT=3000

# Entorno de ejecución: development | production
NODE_ENV="development"

# URL base de la aplicación (inyectada automáticamente en Cloud Run)
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. CLIENTE FRONTEND (FIREBASE CLIENT CONFIG) - OPCIONAL / ANULACIÓN POR ENV
# Si estas variables están ausentes, la app cargará los valores de src/firebase-config.json
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY="AIzaSyBdG4PK68CLI6sGRPjyGhiptVbVt6ZDk44"
VITE_FIREBASE_AUTH_DOMAIN="tu-proyecto.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="tu-proyecto"
VITE_FIREBASE_STORAGE_BUCKET="tu-proyecto.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="637799288556"
VITE_FIREBASE_APP_ID="1:637799288556:web:9c92d703281fff3f891fc9"
# Clave pública de reCAPTCHA Enterprise registrada en Firebase App Check.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=""
